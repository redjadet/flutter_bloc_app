{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": ".cursor/hooks/session-flutter-context.sh",
        "timeout": 5
      }
    ],
    "afterFileEdit": [
      {
        "command": ".cursor/hooks/format-dart-after-edit.sh",
        "matcher": "\\.dart$",
        "timeout": 30
      }
    ],
    "beforeReadFile": [
      {
        "command": ".cursor/hooks/block-sensitive-file-read.sh",
        "timeout": 5
      }
    ]
  }
}
