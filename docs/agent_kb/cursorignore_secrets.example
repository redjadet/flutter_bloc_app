# Optional lines to merge into your local .cursorignore (gitignored).
# Reduces indexing of secret-bearing paths; complements beforeReadFile hook.
# Owner: docs/ai/agent_customization_layers.md

.env
.env.*
!.env.example
.envrc
**/.envrc
**/key.properties
**/*.jks
**/*.keystore
**/google-services.json
!**/google-services.json.sample
!**/ci/**/google-services.json
**/GoogleService-Info.plist
!**/*.sample
!**/ci/**/GoogleService-Info.plist
**/assets/config/secrets.json
!**/secrets.sample.json
