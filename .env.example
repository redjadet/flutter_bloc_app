# Local development secrets (copy to `.env` at repo root — never commit `.env`).
#
# The Flutter app reads these via compile-time `String.fromEnvironment(...)` when
# you run through `tool/direnv/bin/flutter` (on PATH) or:
#   cd apps/mobile && flutter run $(../../tool/flutter_dart_defines_from_env.sh)
#
# `tool/flutter_dart_defines_from_env.sh` loads this file automatically.
# Supported syntax: literal `KEY=value` assignments, optionally quoted for
# spaces. Shell expressions and variable expansion are never evaluated, so
# reading this file never executes code.
#
# Prefer `direnv` + `.envrc` when you want automatic shell export on `cd`.
# Use `.env` when you want a familiar dotenv file without direnv.
#
# Server-only credentials (HUGGINGFACE_API_KEY for FastAPI) stay out of this
# file for Flutter builds — see docs/envrc.example. Shell-only tools may read
# their own keys from `.env`, but the Flutter helper never forwards them.

# Optional Supabase client config (public anon key; security is RLS server-side).
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional Firebase local development (`apps/mobile/lib/firebase_options.dart` placeholders).
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_MESSAGING_SENDER_ID=000000000000
# FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.region.firebasedatabase.app
# FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
# FIREBASE_ANDROID_API_KEY=YOUR_ANDROID_API_KEY
# FIREBASE_ANDROID_APP_ID=1:000000000000:android:placeholder
# FIREBASE_IOS_API_KEY=YOUR_IOS_API_KEY
# FIREBASE_IOS_APP_ID=1:000000000000:ios:placeholder
# FIREBASE_IOS_CLIENT_ID=000000000000-example.apps.googleusercontent.com
# FIREBASE_IOS_BUNDLE_ID=com.example.flutterBlocApp

# Optional local-debug provider keys. Release/profile helpers reject them.
# GEMINI_API_KEY=your_gemini_key
# GOOGLE_API_KEY=
# GOOGLE_MAPS_API_KEY=your_maps_key

# Optional AI Decision Workbench backend override.
# AI_DECISION_API_BASE_URL=http://127.0.0.1:8008

# Optional shell-only Render deploy credential. Never forwarded to Flutter.
# RENDER_API_KEY=your_render_api_key
