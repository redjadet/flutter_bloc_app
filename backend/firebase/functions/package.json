{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "test": "npm run build && node --test test/*.test.js",
    "seed:staff-demo": "node tool/seed_staff_demo.js",
    "setup:staff-demo:content": "node tool/setup_staff_demo_content.js",
    "setup:staff-demo": "npm run seed:staff-demo && npm run setup:staff-demo:content",
    "audit:safe": "node ./tool/audit_safe.mjs",
    "deploy": "bash ../tool/firebase_preflight.sh --require-cli && firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "24.19.0"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.3.2",
    "googleapis": "^173.0.0",
    "twilio": "^6.0.2"
  },
  "overrides": {
    "@tootallnate/once": "^3.0.1",
    "axios": "^1.18.1",
    "body-parser": "2.3.0",
    "brace-expansion": "5.0.9",
    "js-yaml": "5.2.3",
    "minimatch": "^10.2.6",
    "protobufjs": "^8.7.1",
    "rimraf": "^6.1.3",
    "uuid": "^14.0.1",
    "@babel/core": "^8.0.1"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^8.57.1",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.32.0",
    "firebase-functions-test": "^3.5.0",
    "typescript": "~5.8.3"
  },
  "private": true
}
