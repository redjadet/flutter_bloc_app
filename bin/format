#!/usr/bin/env bash
# Format repo Dart files while respecting .gitignore.
#
# Skip trees that are not production sources and may contain Dart the current
# formatter cannot parse (or should not rewrite):
#   - tool/fixtures/**  — guard samples for static scanners
#   - third_party/**    — vendored packages
# Those paths are omitted from the dart format invocation entirely (no stderr
# spam, no soft-skip warning).

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: ./bin/format [--changed] [dart format options]

Formats Git-known Dart files while skipping ignored/generated paths such as
build/ and .dart_tool/.

Always skipped (not passed to dart format):
  - tool/fixtures/**
  - third_party/**

Options:
  --changed   Format changed Dart files only.
  --self-test Verify skip list + dart format on a parseable sample.
  -h, --help  Show help.

Other options are forwarded to dart format.
EOF
}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$PROJECT_ROOT"

# shellcheck disable=SC1091
source "$PROJECT_ROOT/tool/resolve_flutter_dart.sh"

is_skipped_format_path() {
  case "$1" in
    tool/fixtures/*|./tool/fixtures/*|third_party/*|./third_party/*)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

format_changed=0
self_test=0
format_args=()
for arg in "$@"; do
  case "$arg" in
    --changed)
      format_changed=1
      ;;
    --self-test)
      self_test=1
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      format_args+=("$arg")
      ;;
  esac
done

run_self_test() {
  local DART_BIN tmp_ok rc
  DART_BIN="$(resolve_flutter_dart)"
  tmp_ok="$(mktemp "${TMPDIR:-/tmp}/format_selftest_ok.XXXXXX.dart")"
  # shellcheck disable=SC2064
  trap 'rm -f "$tmp_ok"' RETURN

  if ! is_skipped_format_path 'tool/fixtures/example.dart'; then
    echo "format|--self-test|fail|tool/fixtures should be skipped" >&2
    return 1
  fi
  if ! is_skipped_format_path 'third_party/pub/sprintf/lib/x.dart'; then
    echo "format|--self-test|fail|third_party should be skipped" >&2
    return 1
  fi
  if is_skipped_format_path 'apps/mobile/lib/app.dart'; then
    echo "format|--self-test|fail|apps/mobile should not be skipped" >&2
    return 1
  fi

  printf '%s\n' 'void main() { print("ok"); }' >"$tmp_ok"
  set +e
  "$DART_BIN" format "$tmp_ok" >/dev/null 2>&1
  rc=$?
  set -e
  if [[ "$rc" -ne 0 ]]; then
    echo "format|--self-test|fail|parseable sample should format (exit $rc)" >&2
    return 1
  fi

  echo "format|--self-test|ok|skips fixtures+third_party; formats production samples"
  return 0
}

if [[ "$self_test" -eq 1 ]]; then
  run_self_test
  exit $?
fi

dart_files=()
if [[ "$format_changed" -eq 1 ]]; then
  while IFS= read -r file; do
    [[ -z "$file" || "$file" != *.dart || ! -f "$file" ]] && continue
    dart_files+=("$file")
  done < <(
    {
      git diff --name-only --diff-filter=ACMRTUXB
      git diff --cached --name-only --diff-filter=ACMRTUXB
      git ls-files --others --exclude-standard
    } | sort -u
  )
else
  # Skip deleted-but-still-indexed paths (git ls-files --modified lists them).
  while IFS= read -r file; do
    [[ -z "$file" || "$file" != *.dart || ! -f "$file" ]] && continue
    dart_files+=("$file")
  done < <(git ls-files --cached --modified --others --exclude-standard -- '*.dart')
fi

regular_files=()
for file in "${dart_files[@]}"; do
  if is_skipped_format_path "$file"; then
    continue
  fi
  regular_files+=("$file")
done

if [[ "${#regular_files[@]}" -eq 0 ]]; then
  echo "format: no Dart files found"
  exit 0
fi

DART_BIN="$(resolve_flutter_dart)"
"$DART_BIN" format "${format_args[@]}" "${regular_files[@]}"
exit $?
